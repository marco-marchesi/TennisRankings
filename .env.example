# --- Database ---
DATABASE_URL="postgres://user:password@localhost:5432/tennisrankings"

# --- Public site ---
NEXT_PUBLIC_SITE_URL="https://tennisrankings.example"

# --- Auth.js ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="alerts@tennisrankings.example"

# --- Scraper ---
SCRAPER_USER_AGENT="TennisRankingsBot/0.1 (+https://tennisrankings.example/bot)"
SCRAPER_CONTACT_EMAIL="bot@tennisrankings.example"
SCRAPER_KILL_SWITCH="false"       # set "true" to halt all scraping
SCRAPER_MAX_DELTA_PCT="20"        # reject snapshots if delta exceeds this

# --- On-demand ISR revalidate ---
REVALIDATE_SECRET="generate-a-long-random-string"

# --- Observability ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="tennisrankings.example"

# --- Feature flags ---
NEXT_PUBLIC_BETTING_ENABLED="false"
NEXT_PUBLIC_PREMIUM_ENABLED="false"
