# --- Database ---
DATABASE_URL="postgres://user:password@localhost:5432/tennisrankings"

# --- Public site ---
NEXT_PUBLIC_SITE_URL="https://tennisrankings.example"

# --- Scraper ---
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
# Required. scraper/http.ts sends this as the X-Contact header on every
# request, and throws at import time in production if it is still a
# placeholder — identifying ourselves is the basis on which we fetch at all.
SCRAPER_CONTACT_EMAIL="bot@your-domain.example"
SCRAPER_KILL_SWITCH="false"       # set "true" to halt all scraping
SCRAPER_MAX_DELTA_PCT="20"        # reject snapshots if delta exceeds this

# --- On-demand ISR revalidate ---
REVALIDATE_SECRET="generate-a-long-random-string"

# --- Observability ---
# Note: Sentry is configured but not yet initialized — there is no
# instrumentation.ts and next.config.ts is not wrapped in withSentryConfig,
# so these are inert until that is wired up.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Removed ---
# AUTH_SECRET / AUTH_TRUST_HOST      auth deleted (pointed at a non-existent
#                                    /account/sign-in and was never reachable)
# RESEND_API_KEY / EMAIL_FROM        newsletter + magic-link email deleted
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN       analytics deleted with the consent banner
# NEXT_PUBLIC_BETTING_ENABLED        betting surface deleted
# NEXT_PUBLIC_PREMIUM_ENABLED        premium page deleted (dead checkout link)
#
# These can be pruned from your .env.local too; nothing reads them any more.
